<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
	
	<PropertyGroup>
		<AssemblyName>Centuriin.CardGame.Core.Common.Tests</AssemblyName>
		<RootNamespace>Centuriin.CardGame.Core.Common.Tests</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	</PropertyGroup>
	
    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    </ItemGroup>
	
    <ItemGroup>
		<ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>

</Project>